# ─────────────────────────────────────────────────────────────
#  Sentiment-Aware Customer Service Chatbot (Llama 3)
# ─────────────────────────────────────────────────────────────

# Llama 3 backend (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Sentiment backend: "auto" | "transformer" | "lexicon"
#   auto        -> try the transformer model, fall back to lexicon
#   transformer -> force the transformer (raises if not installed)
#   lexicon     -> force the built-in rule/lexicon model
SENTIMENT_BACKEND=auto

# HuggingFace model used when the transformer backend is active
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Server
HOST=0.0.0.0
PORT=8000
